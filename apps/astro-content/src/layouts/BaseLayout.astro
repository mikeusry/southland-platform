---
import '../styles/global.css';
import Header from '../components/shared/Header.astro';
import Footer from '../components/shared/Footer.astro';
import SocialMeta from '../components/shared/SocialMeta.astro';
import PersonaBanner from '../components/cdp/PersonaBanner.astro';
import ChatWidget from '../components/chat/ChatWidget';
import { getLogoUrl } from '../lib/cloudinary';
import { earlyGoogleClickCaptureSource } from '../lib/attribution-storage';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'video.episode';
  canonicalUrl?: string;
  noIndex?: boolean;
  schema?: object;
  articlePublishedTime?: string;
  articleModifiedTime?: string;
  articleAuthor?: string;
  articleSection?: string;
}

const {
  title,
  description,
  ogImage = getLogoUrl('square', { width: 800 }),
  ogType = 'website',
  canonicalUrl,
  noIndex = false,
  schema,
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor,
  articleSection,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://southlandorganics.com';
const fullCanonicalUrl = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const fullOgImage = ogImage.startsWith('http') ? ogImage : new URL(ogImage, siteUrl).href;

// Pixel config
const pixelBrandId = import.meta.env.PUBLIC_PIXEL_BRAND_ID || 'southland';
const pixelEndpoint = import.meta.env.PUBLIC_PIXEL_ENDPOINT || 'https://pixel.southlandorganics.com/collect';

// GTM — same container Shopify checkout already runs (GTM-KT63MW).
// Hardcoded fallback: CI never passed PUBLIC_GTM_CONTAINER_ID, so production
// Astro baked an empty string and the storefront shipped with no Google tag.
// The ID is public (it is in page source on shop.southlandorganics.com).
const gtmContainerId =
  import.meta.env.PUBLIC_GTM_CONTAINER_ID || 'GTM-KT63MW';

// OpenAI Ads (ChatGPT Ads) pixel — provisioned 2026-06-03 from ads.openai.com Conversions tab.
// Hardcoded fallback because the pixel ID is public (browser-side) and the env var
// is only useful if we want to per-environment override.
const openaiAdsPixelId =
  import.meta.env.PUBLIC_OPENAI_ADS_PIXEL_ID || 'CffkPaU7dDnCJjtj4Fd47G';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline set:html={earlyGoogleClickCaptureSource()} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href={fullCanonicalUrl} />

    <!-- Robots -->
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#44883e" />

    <!-- Social Meta Tags -->
    <SocialMeta
      title={title}
      description={description}
      ogImage={fullOgImage}
      ogType={ogType}
      url={fullCanonicalUrl}
      articlePublishedTime={articlePublishedTime}
      articleModifiedTime={articleModifiedTime}
      articleAuthor={articleAuthor}
      articleSection={articleSection}
    />

    <!-- Schema.org JSON-LD -->
    {schema && (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    )}

    <!-- Preconnect to external domains -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- Fonts - Open Sans (body) + Lora (serif/quotes) from Google, Eveleth Dot (headings) loaded via CSS -->
    <!-- Non-render-blocking: loads as print, swaps to all on load -->
    <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Open+Sans:wght@400;500;600;700&display=swap" />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Open+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" /></noscript>

    <!-- Attribution capture (shared rules: attribution-storage.ts) -->
    <script>
      import '../lib/attribution-landing-client'
    </script>

    <!-- point.dog Pixel -->
    <script is:inline define:vars={{ pixelBrandId, pixelEndpoint }}>
      window.pdPixelConfig = {
        brandId: pixelBrandId,
        endpoint: pixelEndpoint
      };
    </script>
    <script src="https://cdn.point.dog/pixel/pd-pixel.min.js?v=2.4.2" async></script>

    <!-- Simpli.fi organization tag — "Southland Organics SITE RT"
         (org 554212, tag id 281561).

         🛑 This tag was ISSUED but never installed. Verified 2026-08-11: the
         `SO - SITE RT- Poultry` retargeting segment reads user_count 1,
         active false, days_inactive 126 — it has been collecting nobody
         because the tag it depends on was never on the site. Meanwhile D2's
         equivalent tag, which IS installed, holds 2,677 users.

         Site-retargeting audiences are "this tag + URL rules", so nothing
         Simpli.fi can retarget on southlandorganics.com works without it.

         🛑 Do not swap in JockShock's tag (5e5a79bc…) or D2's (18f08d36…).
         Wrong tag pools unrelated audiences together and ruins both.

         Conversion tracking additionally needs this tag with tx_val/tx_id on
         the Shopify order-status page — that store is shared with JockShock,
         so both tags belong there. Not done here. -->
    <script
      is:inline
      async
      src="https://tag.simpli.fi/sifitag/679871f8-7c57-41b4-a4c9-7fd24de2efb4"
    ></script>

    <!-- Meta Pixel -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '2459921147627824');
      var pageViewEventId = (crypto.randomUUID && crypto.randomUUID()) ||
        'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
          var r = Math.random() * 16 | 0, v = c === 'x' ? r : (r & 0x3 | 0x8);
          return v.toString(16);
        });
      window.__pdPageViewEventId = pageViewEventId;
      fbq('track', 'PageView', {}, { eventID: pageViewEventId });
    </script>
    <noscript>
      <img height="1" width="1" style="display:none"
        src="https://www.facebook.com/tr?id=2459921147627824&ev=PageView&noscript=1"
      />
    </noscript>

    <!-- OpenAI Ads Pixel (ChatGPT Ads). Server-side CAPI dedups on event_id + type. -->
    <script is:inline define:vars={{ openaiAdsPixelId }}>
      !function(w,d,s,u){if(w.oaiq)return;var q=function(){q.q.push(arguments)};q.q=[];w.oaiq=q;var j=d.createElement(s);j.async=1;j.src=u;var f=d.getElementsByTagName(s)[0];f.parentNode.insertBefore(j,f)}(window,document,"script","https://bzrcdn.openai.com/sdk/oaiq.min.js");
      oaiq("init",{pixelId:openaiAdsPixelId});
      oaiq("measure","page_viewed",{type:"contents"});
    </script>

    <!-- Google Tag Manager -->
    {gtmContainerId && (
      <script is:inline define:vars={{ gtmContainerId }}>
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
        })(window,document,'script','dataLayer', gtmContainerId);
      </script>
    )}
  </head>
  <body class="min-h-screen flex flex-col">
    <!-- Google Tag Manager (noscript) -->
    {gtmContainerId && (
      <noscript>
        <iframe
          src={`https://www.googletagmanager.com/ns.html?id=${gtmContainerId}`}
          height="0"
          width="0"
          style="display:none;visibility:hidden"
        ></iframe>
      </noscript>
    )}

    <Header />

    <main class="flex-1">
      <slot />
    </main>

    <Footer />

    <!-- Persona Banner (Reality Tunnels) — disabled for launch, enable post-launch -->
    <!-- <PersonaBanner position="bottom" showChangeLink /> -->

    <!-- Persona Initialization (handle URL params like ?persona=commercial) -->
    <script>
      import { initPersonaFromUrl } from '../lib/persona';
      // Initialize persona from URL if present (for tracking links)
      initPersonaFromUrl();
    </script>

    <!-- AI Chat Widget (React island, loads when browser idle) -->
    <ChatWidget client:idle />

    <!-- Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function() {
          navigator.serviceWorker.register('/sw.js').catch(function(err) {
            console.log('ServiceWorker registration failed:', err);
          });
        });
      }
    </script>
  </body>
</html>
