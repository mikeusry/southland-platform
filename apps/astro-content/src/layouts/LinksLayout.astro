---
/**
 * Bare layout for /links — same head/pixel as the site, no header/footer/chat.
 * Do not use for indexed pages.
 */
import '../styles/global.css'
import SocialMeta from '../components/shared/SocialMeta.astro'
import { getLogoUrl } from '../lib/cloudinary'

interface Props {
  title: string
  description: string
}

const { title, description } = Astro.props
const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://southlandorganics.com'
const fullCanonicalUrl = new URL(Astro.url.pathname, siteUrl).href
const ogImage = getLogoUrl('square', { width: 800 })
const pixelBrandId = import.meta.env.PUBLIC_PIXEL_BRAND_ID || 'southland'
const pixelEndpoint =
  import.meta.env.PUBLIC_PIXEL_ENDPOINT || 'https://pixel.southlandorganics.com/collect'
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={fullCanonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#44883e" />
    <SocialMeta
      title={title}
      description={description}
      ogImage={ogImage}
      ogType="website"
      url={fullCanonicalUrl}
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline define:vars={{ pixelBrandId, pixelEndpoint }}>
      window.pdPixelConfig = { brandId: pixelBrandId, endpoint: pixelEndpoint }
    </script>
    <script src="https://cdn.point.dog/pixel/pd-pixel.min.js?v=2.4.2" async></script>
  </head>
  <body>
    <slot />
  </body>
</html>
