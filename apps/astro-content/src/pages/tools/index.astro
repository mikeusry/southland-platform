---
/**
 * /tools/ — Decision tools index (discoverability for SEO OS portfolio assets)
 */
import BaseLayout from '../../layouts/BaseLayout.astro'

const title = 'Decision Tools | Southland Organics'
const description =
  'Planners, selectors, and quizzes that route you to the right Southland product docs — claim-safe, label-first.'

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://southlandorganics.com'
const canonicalUrl = `${siteUrl}/tools/`

const tools = [
  {
    href: '/tools/poultry-water-system-planner/',
    name: 'Poultry Water-System Planner',
    blurb: 'Drinkers, cool cells, timing — next guides and ZeroPoint docs. No disease diagnosis.',
    lane: 'Poultry',
  },
  {
    href: '/tools/flock-health-check/',
    name: 'Flock Health Check',
    blurb: 'Backyard flock decision helper with product paths.',
    lane: 'Poultry',
  },
  {
    href: '/tools/flock-dosing-calculator/',
    name: 'Flock Dosing Calculator',
    blurb: 'Size refill amounts around your schedule.',
    lane: 'Poultry',
  },
  {
    href: '/tools/lawn-weed-selector/',
    name: 'Lawn & Hardscape Weed Selector',
    blurb: 'Contact vs systemic framing → Torched paths. Label rates stay on the label.',
    lane: 'Lawn',
  },
  {
    href: '/tools/lawn-quiz/',
    name: 'Lawn Health Quiz',
    blurb: '60-second turf product routing.',
    lane: 'Lawn',
  },
  {
    href: '/lawn/torched-comparison-center/',
    name: 'Torched Comparison & Demo Center',
    blurb: 'Vinegar / contact / systemic honesty + demo film. No glyphosate kill-rate win.',
    lane: 'Lawn',
  },
  {
    href: '/tools/compare/',
    name: 'Biological vs Conventional',
    blurb: 'Scenario comparison for poultry, turf, and ag.',
    lane: 'All',
  },
  {
    href: '/application-rate-calculator/',
    name: 'Application Rate Calculator',
    blurb: 'Quantities and cost for your acreage.',
    lane: 'All',
  },
  {
    href: '/blog/poultry-water-line-biofilm-and-cleaning-hub/',
    name: 'Water-Line Cleaning Evidence Hub',
    blurb: 'Job map for cleaning vs disinfection language — label-aligned.',
    lane: 'Poultry',
  },
] as const

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'Southland Organics Decision Tools',
  description,
  url: canonicalUrl,
}
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl} schema={schema}>
  <section class="bg-[#2C5234] py-16 text-white">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <h1 class="font-heading text-3xl uppercase tracking-wide md:text-4xl">Decision tools</h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-green-100">
        Pick the job. Open the right guide and product docs. Mix rates and animal-health claims stay
        on the label — not invented here.
      </p>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto grid max-w-5xl gap-6 px-4 md:grid-cols-2">
      {
        tools.map((t) => (
          <a
            href={t.href}
            class="block rounded-lg border border-gray-200 bg-white p-6 transition-shadow hover:shadow-md"
          >
            <p class="text-xs font-semibold uppercase tracking-wide text-gray-500">{t.lane}</p>
            <h2 class="mt-1 font-heading text-lg uppercase text-[#2C5234]">{t.name}</h2>
            <p class="mt-2 text-sm text-gray-600">{t.blurb}</p>
            <p class="mt-4 text-sm font-semibold text-[#44883E]">Open →</p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
