---
/**
 * /lawn/program/ — Organic Lawn Care Program
 *
 * Replaces the Shopify page /pages/organic-lawn-care-program, which middleware
 * was redirecting to /lawn/homeowners/. This is the season-by-season "why and
 * when" behind the bundles, with per-product application rates.
 *
 * 🛑 Application rates are transcribed verbatim from the original page. They are
 * dosing figures — do not round or reword them.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../../components/shared/Breadcrumbs.astro'
import CloudinaryHero from '../../../components/CloudinaryHero.astro'
import { buildSouthlandUrl } from '../../../lib/cloudinary'

const title = 'Organic Lawn Care Program | Southland Organics'
const description =
  'A season-by-season organic lawn care program — Genesis in spring, FertALive and Omega through summer, Revival in fall, with application rates for each.'

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://southlandorganics.com'
const canonicalUrl = `${siteUrl}/lawn/program/`

const seasons = [
  {
    n: 1,
    season: 'Spring',
    product: 'Genesis',
    handle: 'genesis',
    body: 'Genesis is the ultimate soil conditioner for bringing out early-season colour and vibrancy in your lawn and turf grass. Trials show turf treated with Genesis has a 78% increase in green-up. More importantly, it prepares the lawn for the hot summer season by delivering activated carbon and rich biology for increased soil activity, energy and overall vitality. It has been shown to increase germination rate, plant height and mass area.',
    rate: 'Apply 10–12 oz. of Genesis per thousand square feet, diluted at a 1:20 product to water ratio. Apply in the spring, starting in March. Apply once a month for a total of 3–4 applications.',
  },
  {
    n: 2,
    season: 'Summer',
    product: 'FertALive and Omega',
    handle: 'fertalive',
    body: 'FertALive is a nutrient enhancer that delivers nutrient-releasing microbiology and vital nitrogen in small amounts, giving weeks of steady nutrition rather than one heavy feed. Omega is our amplified formula of biologically active carbon and organic acids — its proprietary blend of beneficial bacteria promotes nutrient uptake and builds grass resilient to disease and environmental stress.',
    rate: 'Apply FertALive and Omega in the summer, starting in late May and continuing through August or September. Apply 8 oz. of FertALive per thousand square feet, diluted at a 1:30 ratio. Apply 6–8 oz. of Omega per thousand square feet, diluted at a 1:20 ratio. Apply once per month for a total of 4 applications.',
  },
  {
    n: 3,
    season: 'Fall',
    product: 'Revival',
    handle: 'turf-revival',
    body: 'Revival is the ultimate microbial dethatcher, liquid aerator and compost accelerant. It breaks down your lawn’s thatch organically and converts it to usable nutrients to keep your grass healthy — letting you avoid the cost and time of physical thatch removal and mechanical aeration.',
    rate: 'Apply 5–7 oz. of Revival per thousand square feet, diluted at a 1:20 ratio. Apply in the fall, starting in September. Apply once per month for a total of 2 applications.',
  },
]

const ogImage = buildSouthlandUrl('Southland Website/heroes/lawn_result_ait3ra', {
  width: 1200,
  height: 630,
  crop: 'fill',
  gravity: 'auto',
  quality: 'auto',
  format: 'auto',
})

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'Organic Lawn Care Program',
  description,
  url: canonicalUrl,
  step: seasons.map((s) => ({
    '@type': 'HowToStep',
    position: s.n,
    name: `${s.season} — ${s.product}`,
    text: s.rate,
  })),
}
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImage={ogImage}
  schema={schema}
>
  <!-- HERO -->
  <CloudinaryHero
    publicId="Southland Website/heroes/lawn_result_ait3ra"
    alt="A healthy lawn maintained on an organic program"
    height={480}
    minHeight="400px"
    overlay="gradient"
    overlayOpacity={88}
    contentAlign="center"
    contentJustify="start"
    priority={true}
  >
    <div class="mx-auto w-full max-w-6xl pb-10 pt-12 md:pt-16">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: 'Lawn & Turf', href: '/lawn/' },
          { label: 'Organic Lawn Care Program' },
        ]}
        class="mb-4 [&_*]:text-sm [&_a]:text-white/80 [&_span]:text-white/60"
      />
      <div class="max-w-3xl">
        <span
          class="mb-3 inline-block rounded-full bg-white/15 px-4 py-1 text-sm font-medium text-green-300"
        >
          Spring · Summer · Fall
        </span>
        <h1
          class="mb-4 font-heading text-4xl uppercase leading-tight text-white md:text-5xl lg:text-6xl"
        >
          A green lawn without the chemical treadmill.
        </h1>
        <p class="mb-6 text-lg text-white/70 md:text-xl">
          Three seasons, four products, and a rate for each one — safe for your family, your pets
          and the ground water under your yard.
        </p>
        <a
          href="/lawn/bundles/"
          class="inline-flex items-center gap-2 rounded-lg bg-[#44883E] px-6 py-3.5 font-semibold text-white transition-colors hover:bg-[#44883E]/85"
        >
          Find My Bundle
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </CloudinaryHero>

  <!-- SEASONS -->
  <section class="bg-white py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4">
      <div class="mb-12 text-center">
        <h2 class="mb-3 font-heading text-3xl uppercase text-shopify-title md:text-4xl">
          The program, season by season.
        </h2>
        <p class="mx-auto max-w-2xl text-gray-600">
          Each product does a different job at a different point in the year. Miss one and you get a
          fraction of the result.
        </p>
      </div>
      <div class="space-y-8">
        {
          seasons.map((s) => (
            <article class="rounded-xl border border-gray-200 bg-white p-6 transition-shadow hover:shadow-lg md:p-8">
              <div class="mb-4 flex items-center gap-4">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-green-100 text-xl font-bold text-green-700">
                  {s.n}
                </span>
                <div>
                  <p class="text-xs uppercase tracking-wide text-[#44883E]">{s.season}</p>
                  <h3 class="font-heading text-2xl uppercase text-shopify-title">{s.product}</h3>
                </div>
              </div>
              <p class="leading-relaxed text-gray-700">{s.body}</p>
              <div class="mt-5 rounded-lg border-l-4 border-[#44883E] bg-green-50/60 p-4">
                <h4 class="font-heading text-sm uppercase text-shopify-title">Application Rate</h4>
                <p class="mt-1 text-sm leading-relaxed text-gray-700">{s.rate}</p>
              </div>
              <a
                href={`/products/${s.handle}/`}
                class="mt-5 inline-flex items-center gap-1 text-sm font-semibold text-[#44883E] hover:underline"
              >
                About {s.product.split(' and ')[0]}
                <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- PROOF BAND -->
  <section class="bg-[#2C5234] py-12 md:py-16">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-3 text-center font-heading text-3xl uppercase text-white md:text-4xl">
        What conventional lawn care costs.
      </h2>
      <p class="mx-auto mb-10 max-w-lg text-center text-sm text-green-200/80">
        The numbers behind the shift to biology.
      </p>
      <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
        <div class="text-center">
          <div class="text-3xl font-bold text-green-300 md:text-4xl">$45B</div>
          <div class="mt-1 text-sm font-medium text-white">Spent per year in the US</div>
          <div class="mt-0.5 text-xs text-green-200/70">Services, fertilizer, pesticides</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-green-300 md:text-4xl">10×</div>
          <div class="mt-1 text-sm font-medium text-white">More fertilizer per acre</div>
          <div class="mt-0.5 text-xs text-green-200/70">Homeowners vs. farmers (ATTRA)</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-green-300 md:text-4xl">78%</div>
          <div class="mt-1 text-sm font-medium text-white">Increase in green-up</div>
          <div class="mt-0.5 text-xs text-green-200/70">Turf treated with Genesis</div>
        </div>
        <div class="text-center">
          <div class="text-3xl font-bold text-green-300 md:text-4xl">3</div>
          <div class="mt-1 text-sm font-medium text-white">Seasons, one program</div>
          <div class="mt-0.5 text-xs text-green-200/70">Spring, summer, fall</div>
        </div>
      </div>
    </div>
  </section>

  <!-- WHY SHIFT -->
  <section class="bg-gray-50 py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-4">
      <h2 class="mb-6 text-center font-heading text-3xl uppercase text-shopify-title md:text-4xl">
        Shifting from conventional to natural.
      </h2>
      <div class="space-y-5 text-lg leading-relaxed text-gray-700">
        <p>
          Americans spend over <span class="font-semibold text-shopify-title">$45 billion</span> a year
          on lawn care services, fertilizers and pesticides. According to the ATTRA Sustainable Turf Care
          guide, the average homeowner uses <span class="font-semibold text-shopify-title"
            >ten times more chemical fertilizer per acre</span
          > than farmers use on farmland.
        </p>
        <p>
          Over-application does not just cost money. High fertilization increases susceptibility to
          chinch bugs, sod webworms, parasitic nematodes and brown patch — much like overusing
          antibacterial soap leaves you more prone to infection, not less.
        </p>
        <p>
          You can have a healthier, lower-maintenance lawn without losing the well-kept look.
          Natural management practices benefit the environment and save time and money in the long
          run.
        </p>
      </div>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="bg-[#2C5234] py-16 text-white">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="font-heading text-3xl uppercase md:text-4xl">
        Get the whole program in one bundle.
      </h2>
      <p class="mx-auto mt-3 max-w-xl text-green-100">
        We package all four products in the right quantities for your turf zone and lawn size — so
        you are not measuring anything or guessing at rates.
      </p>
      <div class="mt-8 flex flex-col items-center gap-3 sm:flex-row sm:justify-center">
        <a
          href="/lawn/bundles/"
          class="inline-flex items-center gap-2 rounded-lg bg-white px-6 py-3.5 font-semibold text-[#2C5234] transition-colors hover:bg-green-50"
        >
          Find My Bundle
          <span aria-hidden="true">→</span>
        </a>
        <a
          href="/lawn/instructions/"
          class="inline-flex items-center gap-2 rounded-lg border-2 border-white/30 px-6 py-3.5 font-semibold text-white transition-colors hover:border-white/60 hover:bg-white/5"
        >
          Bundle Instructions
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
