---
/**
 * /lawn/instructions/ — Natural Lawn Care Instructions
 *
 * Replaces the Shopify page /pages/natural-lawn-care-instructions, which four
 * blog posts still link to and which middleware was redirecting to
 * /lawn/homeowners/ — a page carrying none of this content.
 *
 * 🛑 The schedules and dilution steps are DOSING INSTRUCTIONS transcribed
 * verbatim from the original page. Do not paraphrase them for tone.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../../components/shared/Breadcrumbs.astro'
import { DILUTION, LAWN_BUNDLES, LAWN_SIZES, TURF_ZONES } from '../../../lib/lawnBundleData'

const title = 'Natural Lawn Care Instructions | Southland Organics'
const description =
  'Month-by-month application schedules and dilution instructions for all nine Southland Organics Natural Lawn Care Bundles.'

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://southlandorganics.com'
const canonicalUrl = `${siteUrl}/lawn/instructions/`

const schema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: 'How to apply a Southland Organics Natural Lawn Care Bundle',
  description,
  url: canonicalUrl,
  step: LAWN_BUNDLES[0].schedule.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.month,
    text: s.action,
  })),
}

const label = (b: (typeof LAWN_BUNDLES)[number]) =>
  `${TURF_ZONES.find((z) => z.id === b.zone)?.label} turf zone, ${LAWN_SIZES.find(
    (s) => s.id === b.size
  )?.label.toLowerCase()} lawn`
---

<BaseLayout title={title} description={description} canonicalUrl={canonicalUrl} schema={schema}>
  <Breadcrumbs
    items={[
      { label: 'Lawn', href: '/lawn/' },
      { label: 'Bundle Instructions', href: '/lawn/instructions/' },
    ]}
  />

  <section class="bg-[#2C5234] py-16 text-white">
    <div class="mx-auto max-w-4xl px-4 text-center">
      <h1 class="font-heading text-3xl uppercase tracking-wide md:text-4xl">
        Natural Lawn Care Instructions
      </h1>
      <p class="mx-auto mt-4 max-w-2xl text-lg text-green-100">
        Find your bundle below for a month-by-month schedule. You'll apply one product, once per
        month, using the entire bottle in each application.
      </p>
    </div>
  </section>

  <!-- Dilution -->
  <section class="py-12">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="font-heading text-2xl uppercase text-[#2C5234]">Dilution Instructions</h2>
      <p class="mt-2 text-gray-600">
        All four products in the Natural Lawn Care Bundles are applied with a hose end sprayer.
      </p>
      <div class="mt-6 grid gap-6 md:grid-cols-2">
        {
          (['sprayer-quart', 'own-sprayer'] as const).map((fmt) => (
            <div class="rounded-lg border border-gray-200 bg-white p-6 shadow-sm">
              <h3 class="font-heading text-sm uppercase text-[#2C5234]">{DILUTION[fmt].heading}</h3>
              <ol class="mt-3 list-decimal space-y-2 pl-5 text-sm text-gray-700">
                {DILUTION[fmt].steps.map((s) => (
                  <li>{s}</li>
                ))}
              </ol>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Not sure which bundle -->
  <section class="bg-gray-50 py-10">
    <div class="mx-auto max-w-3xl px-4 text-center">
      <h2 class="font-heading text-xl uppercase text-[#2C5234]">
        Not Sure Which Bundle Is Right for You?
      </h2>
      <p class="mt-2 text-gray-600">Answer two questions and we'll match you to the right one.</p>
      <a
        href="/lawn/bundles/"
        class="mt-5 inline-block rounded-md bg-[#2C5234] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#24432b]"
      >
        Find My Bundle
      </a>
    </div>
  </section>

  <!-- Per-bundle schedules -->
  <section class="py-12">
    <div class="mx-auto max-w-4xl px-4">
      <h2 class="font-heading text-2xl uppercase text-[#2C5234]">Bundle Schedules</h2>
      <div class="mt-6 space-y-4">
        {
          LAWN_BUNDLES.map((b) => (
            <details
              id={`bundle-${b.number}`}
              class="rounded-lg border border-gray-200 bg-white shadow-sm"
            >
              <summary class="cursor-pointer px-6 py-4 font-heading text-base uppercase text-[#2C5234]">
                Lawn Bundle #{b.number}
                <span class="ml-2 text-xs normal-case text-gray-500">{label(b)}</span>
              </summary>
              <div class="border-t border-gray-100 px-6 py-4">
                <ol class="space-y-2">
                  {b.schedule.map((s) => (
                    <li class="flex gap-4">
                      <span class="w-24 shrink-0 font-heading text-sm uppercase text-[#2C5234]">
                        {s.month}
                      </span>
                      <span class="text-sm text-gray-700">{s.action}</span>
                    </li>
                  ))}
                </ol>
                <p class="mt-4 text-xs text-gray-500">
                  See the dilution instructions above for your container format.
                </p>
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
