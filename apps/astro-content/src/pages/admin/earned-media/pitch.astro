---
import AdminLayout from '../../../layouts/AdminLayout.astro'
import PitchDeskScreen from '@pointdog/admin-core/components/PitchDeskScreen.astro'
import {
  activePitchFor,
  applyPitchAction,
  applyPitchForm,
  blankPitch,
  type Opportunity,
  type Pitch,
} from '@pointdog/admin-core'
import { loadEarnedMedia, saveOpportunity, savePitch } from '@pointdog/admin-core/api'
import { getServerEnv } from '../../../lib/server-env'

export const prerender = false

const brandId = 'southland'
const supabaseUrl = getServerEnv(Astro.locals, 'MOTHERSHIP_SUPABASE_URL')
const serviceKey = getServerEnv(Astro.locals, 'MOTHERSHIP_SUPABASE_SERVICE_KEY')

let error: string | null = null
let notice: string | null = Astro.url.searchParams.get('notice')
let opportunityId = Astro.url.searchParams.get('opportunity')

let opportunities: Awaited<ReturnType<typeof loadEarnedMedia>>['opportunities'] = []
let pitches: Awaited<ReturnType<typeof loadEarnedMedia>>['pitches'] = []
let scorecard: Awaited<ReturnType<typeof loadEarnedMedia>>['scorecard'] = {
  opportunitiesInbox: 0,
  opportunitiesQualified: 0,
  pitchesApproved: 0,
  pitchesSent: 0,
  placementsPublished: 0,
  verifiedLinks: 0,
  verifiedUnlinkedMentions: 0,
  highValueCommercial: 0,
  rejected: 0,
  claimsBlocked: 0,
  activeWip: 0,
}
let opportunity: Opportunity | null = null
let pitch: Pitch | null = null

if (!supabaseUrl || !serviceKey) {
  error = 'Earned-media storage is not configured.'
} else {
  try {
    const loaded = await loadEarnedMedia(supabaseUrl, serviceKey, brandId)
    opportunities = loaded.opportunities
    pitches = loaded.pitches
    scorecard = loaded.scorecard

    if (Astro.request.method === 'POST') {
      const data = await Astro.request.formData()
      opportunityId =
        typeof data.get('opportunityId') === 'string'
          ? String(data.get('opportunityId'))
          : opportunityId
      const found = loaded.opportunities.find((row) => row.id === opportunityId)
      if (!found) {
        error = 'Qualify an opportunity before drafting a pitch'
      } else {
        const id = typeof data.get('id') === 'string' ? String(data.get('id')) : ''
        const existing =
          loaded.pitches.find((row) => row.id === id) ?? blankPitch(found, id || undefined)
        const drafted = applyPitchForm(existing, data)
        const action = typeof data.get('action') === 'string' ? String(data.get('action')) : 'save'
        const result = applyPitchAction(drafted, found, action)
        opportunity = result.opportunity
        pitch = result.pitch
        if (result.error) {
          error = result.error
        } else {
          await savePitch(supabaseUrl, serviceKey, result.pitch)
          if (result.opportunity.status !== found.status) {
            await saveOpportunity(supabaseUrl, serviceKey, result.opportunity)
          }
          return Astro.redirect(`/admin/earned-media/pitch?opportunity=${found.id}&notice=Saved`)
        }
      }
    }

    if (!opportunity) {
      opportunity = opportunityId
        ? (opportunities.find((row) => row.id === opportunityId) ?? null)
        : (opportunities[0] ?? null)
    }
    if (!pitch && opportunity) {
      pitch = activePitchFor(opportunity.id, pitches) ?? blankPitch(opportunity)
    }
  } catch (caught) {
    error = caught instanceof Error ? caught.message : 'Could not load pitch desk'
  }
}
---

<AdminLayout title="Pitch desk" activeNav="/admin/earned-media" wide>
  <PitchDeskScreen
    opportunities={opportunities}
    opportunity={opportunity}
    pitch={pitch}
    scorecard={scorecard}
    error={error}
    notice={notice}
  />
</AdminLayout>
