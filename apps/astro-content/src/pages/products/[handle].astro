---
/**
 * /products/[handle] — Product Detail Page (SSR)
 *
 * Resolves TinaCMS slug → Shopify handle, loads the product (with one retry on
 * Storefront API errors), then renders the PDP or an appropriate error state.
 */
import { createClient } from '@southland/shopify-storefront'
import { getCollection } from 'astro:content'
import { isValidPersonaId, type PersonaId } from '../../lib/persona'
import { loadProductForProductPage } from '../../lib/product-page-shopify'
import ProductDetailView from '../../components/product/ProductDetailView.astro'
import ProductShopifyUnavailable from '../../components/product/ProductShopifyUnavailable.astro'

const { handle } = Astro.params

if (!handle) {
  return Astro.redirect('/products/')
}

const personaCookie = Astro.cookies.get('sl_persona')?.value ?? null
const LEGACY_MAP: Record<string, string> = { backyard: 'betty', commercial: 'bill', lawn: 'taylor' }
const resolvedCookie = personaCookie ? (LEGACY_MAP[personaCookie] ?? personaCookie) : null
const persona: PersonaId =
  resolvedCookie && isValidPersonaId(resolvedCookie) ? (resolvedCookie as PersonaId) : null

const allProducts = await getCollection('products')
const tinaProduct =
  allProducts.find(
    (p) => p.data.shopifyHandle === handle || p.id.replace(/\.mdx?$/, '') === handle
  ) ?? null

const shopifyHandle = tinaProduct?.data.shopifyHandle ?? handle

const client = createClient({
  storeDomain: import.meta.env.PUBLIC_SHOPIFY_STORE_DOMAIN,
  publicAccessToken: import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN,
})

const productLoad = await loadProductForProductPage(client, shopifyHandle)

if (productLoad.outcome === 'not_found') {
  return new Response(null, { status: 404, statusText: 'Product not found' })
}
---

{
  productLoad.outcome === 'unavailable' ? (
    <ProductShopifyUnavailable />
  ) : productLoad.outcome === 'product' ? (
    <ProductDetailView
      product={productLoad.product}
      handle={handle}
      shopifyHandle={shopifyHandle}
      tinaProduct={tinaProduct}
      persona={persona}
    />
  ) : null
}
