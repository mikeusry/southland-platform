---
/**
 * /pages/[slug] — Shopify shop policies (SSR)
 *
 * Renders legal policies from Shopify Admin via the Storefront API.
 * Footer links: /pages/privacy-policy, /pages/terms-of-service, etc.
 */
import {
  createClient,
  getShopPolicy,
  getShopPolicyUnauthenticated,
  policySlugToField,
} from '@southland/shopify-storefront'
import BaseLayout from '../../layouts/BaseLayout.astro'
import Breadcrumbs from '../../components/shared/Breadcrumbs.astro'
import { getServerEnv } from '../../lib/server-env'
import {
  demotePolicyBodyH1,
  metaDescriptionFromPolicyHtml,
  shopPolicyCanonicalUrl,
} from '../../lib/shop-policy-meta'

const { slug } = Astro.params

if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not found' })
}

const policyField = policySlugToField(slug)
if (!policyField) {
  return new Response(null, { status: 404, statusText: 'Not found' })
}

const storeDomain =
  getServerEnv(Astro.locals, 'PUBLIC_SHOPIFY_STORE_DOMAIN') ||
  import.meta.env.PUBLIC_SHOPIFY_STORE_DOMAIN ||
  'southland-organics.myshopify.com'
const publicAccessToken =
  getServerEnv(Astro.locals, 'PUBLIC_SHOPIFY_STOREFRONT_TOKEN') ||
  import.meta.env.PUBLIC_SHOPIFY_STOREFRONT_TOKEN

let policy = null
if (publicAccessToken) {
  try {
    policy = await getShopPolicy(createClient({ storeDomain, publicAccessToken }), policyField)
  } catch (error) {
    console.error('[pages/policy] authenticated Shopify client failed:', error)
  }
}
if (!policy?.body?.trim()) {
  policy = await getShopPolicyUnauthenticated(storeDomain, policyField)
}

if (!policy?.body?.trim()) {
  return new Response(null, { status: 404, statusText: 'Policy not found' })
}

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://southlandorganics.com'
const canonicalUrl = shopPolicyCanonicalUrl(siteUrl, slug)
const pageTitle = `${policy.title} | Southland Organics`
const description = metaDescriptionFromPolicyHtml(policy.body)
const policyBodyHtml = demotePolicyBodyH1(policy.body)

Astro.response.headers.set('Cache-Control', 'public, s-maxage=3600, stale-while-revalidate=86400')
---

<BaseLayout title={pageTitle} description={description} canonicalUrl={canonicalUrl}>
  <section class="bg-southland-green-dark py-10 md:py-14">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <Breadcrumbs
        items={[
          { label: 'Home', href: '/' },
          { label: policy.title, href: `/pages/${slug}/` },
        ]}
      />
      <h1 class="mt-4 font-heading text-3xl text-white md:text-4xl lg:text-5xl">
        {policy.title}
      </h1>
    </div>
  </section>

  <section class="bg-white py-12 md:py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div
        class="prose prose-lg max-w-none prose-headings:font-heading prose-headings:text-shopify-title prose-a:text-brand-green-light"
        set:html={policyBodyHtml}
      />
    </div>
  </section>
</BaseLayout>
