---
/**
 * Email capture component — posts to Customer.io via /api/subscribe.
 * Used across podcast and content pages.
 *
 * Was wired straight to Klaviyo's browser API until 2026-08-12. Klaviyo was
 * retired as ESP in Jul 2026, but that endpoint still returns 202, so every
 * signup kept showing "You're in!" while landing in a dead ESP. The Customer.io
 * Track API needs a secret key, so the call now goes through a server route
 * rather than the browser.
 *
 * `listId` is retained as a no-op prop: four Klaviyo list ids are still passed
 * by callers (QQxdLS, Rv67aH, TckeZK). Audience is now carried by `source`,
 * which the API maps to Customer.io attributes. Remove the prop once callers
 * are cleaned up.
 *
 * Subscribers get these attributes:
 * - newsletter_subscriber: true
 * - newsletter_subscribed_at: ISO timestamp
 * - newsletter_signup_source: the `source` prop
 * Podcast sources additionally get podcast_subscriber / podcast_signup_episode.
 */

interface Props {
  headline?: string
  description?: string
  /** @deprecated Klaviyo list id — accepted but ignored. Audience comes from `source`. */
  listId?: string
  source?:
    | 'episode_page'
    | 'hub'
    | 'footer'
    | 'blog'
    | 'website'
    | 'biosecurity'
    | 'lawn'
    | 'case-study'
  episodeSlug?: string
  buttonText?: string
  variant?: 'inline' | 'card' | 'banner'
  class?: string
}

const {
  headline = 'Subscribe to Ag & Culture',
  description = 'Get notified when new episodes drop, plus exclusive content and tips.',
  source = 'website',
  episodeSlug = '',
  buttonText = 'Subscribe',
  variant = 'card',
  class: className = '',
} = Astro.props

const variantClasses = {
  inline: '',
  card: 'bg-white rounded-xl shadow-sm border border-gray-100 p-6',
  banner: 'text-white',
}

const inputClasses =
  variant === 'banner'
    ? 'w-full px-4 py-3 rounded-lg border border-gray-200 text-gray-900 bg-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-white/60 focus:border-transparent transition-all duration-200'
    : 'w-full px-4 py-3 rounded-lg border border-gray-200 focus:outline-none focus:ring-2 focus:ring-southland-green focus:border-transparent'

const buttonClasses =
  variant === 'banner'
    ? 'w-full sm:w-auto px-8 py-3 bg-southland-green text-white font-bold rounded-lg shadow-md hover:bg-[#3a7534] hover:shadow-lg active:scale-[0.98] focus:outline-none focus:ring-2 focus:ring-white/60 focus:ring-offset-2 focus:ring-offset-southland-green-dark transition-all duration-200'
    : 'w-full sm:w-auto btn-primary'
---

<div
  class={`email-capture ${variantClasses[variant]} ${className}`}
  data-source={source}
  data-episode-slug={episodeSlug}
>
  {
    (headline || description) && (
      <div class="mb-4">
        {headline && (
          <h3 class={`text-lg font-bold ${variant === 'banner' ? 'text-white' : 'text-gray-900'}`}>
            {headline}
          </h3>
        )}
        {description && (
          <p class={`mt-1 text-sm ${variant === 'banner' ? 'text-white/80' : 'text-gray-600'}`}>
            {description}
          </p>
        )}
      </div>
    )
  }

  <form class="subscribe-form flex flex-col gap-3 sm:flex-row">
    <div class="flex-1">
      <label for="email-capture-input" class="sr-only">Email address</label>
      <input
        type="email"
        id="email-capture-input"
        name="email"
        placeholder="Enter your email"
        required
        class={inputClasses}
      />
    </div>
    <button type="submit" class={buttonClasses}>
      {buttonText}
    </button>
  </form>

  <!-- Success message (hidden by default) -->
  <div class="success-message hidden">
    <div
      class={`flex items-center gap-3 p-4 rounded-lg ${variant === 'banner' ? 'bg-white/10 text-white' : 'bg-green-50 text-southland-green'}`}
    >
      <svg class="h-6 w-6 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <div>
        <p class="font-semibold">You're in!</p>
        <p class={`text-sm ${variant === 'banner' ? 'text-white/80' : 'text-gray-600'}`}>
          We'll notify you when new episodes drop.
        </p>
      </div>
    </div>
  </div>

  <!-- Error message (hidden by default) -->
  <div class="error-message mt-4 hidden">
    <div class="flex items-center gap-2 text-red-500">
      <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
      </svg>
      <span class="font-medium">Something went wrong. Please try again.</span>
    </div>
  </div>
</div>

<script>
  // Posts to /api/subscribe, which talks to Customer.io server-side.
  document.querySelectorAll('.subscribe-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()

      const formEl = e.target as HTMLFormElement
      const emailInput = formEl.querySelector('input[type="email"]') as HTMLInputElement
      const container = formEl.closest('.email-capture')
      const source = container?.getAttribute('data-source') || 'website'
      const episodeSlug = container?.getAttribute('data-episode-slug') || ''

      const email = emailInput?.value
      if (!email) return

      const submitButton = formEl.querySelector('button[type="submit"]') as HTMLButtonElement
      const originalLabel = submitButton.textContent || 'Subscribe'
      const successMessage = formEl.parentElement?.querySelector('.success-message')
      const errorMessage = formEl.parentElement?.querySelector('.error-message')

      errorMessage?.classList.add('hidden')
      submitButton.disabled = true
      submitButton.textContent = 'Subscribing...'

      const isPodcastSource =
        ['episode_page', 'hub', 'footer'].includes(source) ||
        window.location.pathname.includes('/podcast')

      // Identify to the point.dog pixel BEFORE the round-trip.
      //
      // Two reasons for the ordering: identify must land before any track() or
      // the event attaches to a profile with no email, and doing it up front
      // means the identity survives even if the API is slow or the visitor
      // navigates away mid-request. identify() hashes locally — no plaintext
      // email is ever sent to the pixel endpoint.
      if (window.pdPixel?.identify) {
        try {
          await window.pdPixel.identify({ email })
        } catch (e) {
          // Never let identity capture break the signup itself.
          console.error('pdPixel.identify failed:', e)
        }
      }

      try {
        const response = await fetch('/api/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            email,
            source,
            signupPage: window.location.pathname,
            episodeSlug: episodeSlug || undefined,
          }),
        })

        // Only a real 2xx counts. The whole point of this rewrite is that a
        // subscriber must never see "You're in!" unless they actually are.
        if (!response.ok) {
          throw new Error(`Subscription failed: ${response.status}`)
        }

        formEl.classList.add('hidden')
        successMessage?.classList.remove('hidden')

        // Also hide the headline/description
        const header = container?.querySelector('.mb-4')
        if (header) {
          header.classList.add('hidden')
        }

        if (window.pdPixel) {
          window.pdPixel.track('email_signup', {
            source: source,
            podcast_subscriber: isPodcastSource,
            episode_slug: episodeSlug || null,
          })
        }
      } catch (error) {
        console.error('Email signup error:', error)
        errorMessage?.classList.remove('hidden')
        submitButton.disabled = false
        submitButton.textContent = originalLabel
      }
    })
  })
</script>
