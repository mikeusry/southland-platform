---
import BaseLayout from '../../layouts/BaseLayout.astro'
const title = 'Product temporarily unavailable | Southland Organics'
const description = 'Our product catalog is briefly unavailable. Please try again in a moment.'
---

<BaseLayout title={title} description={description} noIndex>
  <main class="mx-auto max-w-2xl px-4 py-16 text-center">
    <p class="text-4xl" aria-hidden="true">⚠️</p>
    <h1 class="mt-4 font-heading text-2xl text-gray-900 sm:text-3xl">
      Product temporarily unavailable
    </h1>
    <p class="mt-3 text-base leading-relaxed text-gray-600">
      We could not load this product from our store right now. Please try again in a moment.
    </p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a
        href="/products/"
        class="inline-flex items-center justify-center rounded-lg bg-brand-green-light px-6 py-3 text-sm font-semibold text-white transition hover:bg-brand-green-dark"
      >
        Browse products
      </a>
      <a
        href="tel:800-608-3755"
        class="inline-flex items-center justify-center rounded-lg border border-gray-300 px-6 py-3 text-sm font-semibold text-gray-800 transition hover:bg-gray-50"
      >
        Call 800-608-3755
      </a>
    </div>
  </main>
</BaseLayout>
